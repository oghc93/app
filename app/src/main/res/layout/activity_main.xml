<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Status + tombol connect -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingTop="12dp">

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:textStyle="bold"
            android:text="Terputus" />

        <TextView
            android:id="@+id/tvServerName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:layout_marginTop="4dp"
            android:text="Belum ada server dipilih" />

        <Button
            android:id="@+id/btnConnect"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:layout_marginTop="24dp"
            android:text="CONNECT" />
    </LinearLayout>

    <!-- Panel monitoring: durasi, upload, download -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="28dp"
        android:weightSum="3">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Durasi" android:textSize="12sp" android:textColor="#888880" />
            <TextView android:id="@+id/tvDuration" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="00:00:00" android:textSize="15sp" android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Upload" android:textSize="12sp" android:textColor="#888880" />
            <TextView android:id="@+id/tvUpload" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="0 KB" android:textSize="15sp" android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Download" android:textSize="12sp" android:textColor="#888880" />
            <TextView android:id="@+id/tvDownload" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="0 KB" android:textSize="15sp" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Daftar server -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Server tersimpan"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginTop="28dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvServers"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:nestedScrollingEnabled="false" />

    <Button
        android:id="@+id/btnImportLink"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="+ Import link (VLESS/VMess/Trojan)" />

    <Button
        android:id="@+id/btnAddSsh"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="+ Tambah SSH manual" />

</LinearLayout>
</ScrollView>
